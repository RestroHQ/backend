generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  username             String?   @unique
  password             String
  passwordResetToken   String?
  passwordResetExpires DateTime?
  phone                String?   @db.VarChar(20)
  role                 Role      @default(USER)
  image                String?
  isActive             Boolean   @default(true)

  ownedRestaurants Restaurant[]      @relation("RestaurantOwner")
  staffAt          RestaurantStaff[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email, role])
  @@index([phone])
}

model Customer {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  username             String?   @unique
  password             String
  passwordResetToken   String?
  passwordResetExpires DateTime?
  phone                String?   @db.VarChar(20)
  image                String?
  isActive             Boolean   @default(true)
  restaurantId         String

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  createdOrders Order[]       @relation("CustomerCreatedOrders")
  reservations  Reservation[]
  waitlists     Waitlist[]
  reviews       Review[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([restaurantId])
}

model Restaurant {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  description       String?
  phone             String?          @db.VarChar(20)
  email             String?
  address           String?
  website           String?
  logo              String?
  coverImage        String?
  cuisineType       String
  openingTime       String
  closingTime       String
  openDays          String[]
  taxNumber         String?
  capacity          Int?
  isDeliveryEnabled Boolean          @default(false)
  status            RestaurantStatus @default(ACTIVE)
  isActive          Boolean          @default(true)
  ownerId           String

  staff        RestaurantStaff[]
  orders       Order[]           @relation("RestaurantOrders")
  tables       Table[]           @relation("RestaurantTables")
  reservations Reservation[]     @relation("RestaurantReservations")
  timeSlots    TimeSlot[]        @relation("RestaurantTimeSlots")
  waitlists    Waitlist[]        @relation("RestaurantWaitlists")
  menus        Menu[]            @relation("RestaurantMenus")
  reviews      Review[]          @relation("RestaurantReviews")
  customers    Customer[]
  emailsList   EmailsList[]
  posSession   PosSession[]
  cashRegister CashRegister[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner User @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([status, isActive])
}

model RestaurantStaff {
  id           String         @id @default(cuid())
  restaurantId String
  userId       String
  role         RestaurantRole
  joinedAt     DateTime       @default(now())

  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  posSession        PosSession[]
  cashRegisterEntry CashRegisterEntry[]
  createdOrders     Order[]             @relation("StaffCreatedOrders")

  @@unique([restaurantId, userId])
  @@index([restaurantId, role])
}

model Order {
  id              String        @id @default(cuid())
  restaurantId    String
  createdById     String
  createdByType   CreatedByType
  tableId         String?
  orderType       OrderType     @default(DINE_IN)
  deliveryAddress String?
  deliveryFee     Decimal?      @db.Decimal(10, 2)
  discountAmount  Decimal?      @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  notes           String?
  orderChannel    OrderChannel? @default(POS)
  sessionId       String?
  amountPaid      Decimal?      @db.Decimal(10, 2)
  changeAmount    Decimal?      @db.Decimal(10, 2)
  isVoided        Boolean       @default(false)
  voidReason      String?
  voidedAt        DateTime?
  voidedBy        String?

  items    OrderItem[]
  payments OrderPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant        Restaurant       @relation("RestaurantOrders", fields: [restaurantId], references: [id], onDelete: Restrict)
  table             Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdByStaff    RestaurantStaff? @relation("StaffCreatedOrders", fields: [createdById], references: [id], map: "Order_createdByStaff_fkey")
  createdByCustomer Customer?        @relation("CustomerCreatedOrders", fields: [createdById], references: [id], map: "Order_createdByCustomer_fkey")
  session           PosSession?      @relation(fields: [sessionId], references: [id])

  @@index([createdById])
  @@index([sessionId])
  @@index([restaurantId, status, createdAt])
  @@index([tableId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
}

model OrderPayment {
  id             String        @id @default(cuid())
  orderId        String
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  status         PaymentStatus @default(PENDING)
  paymentType    PaymentType?
  cardLast4      String?
  cardType       String?
  transactionId  String?
  receiptNumber  String?
  refundedAmount Decimal?      @db.Decimal(10, 2)
  refundReason   String?
  refundedAt     DateTime?
  refundedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([transactionId])
  @@index([receiptNumber])
}

model Table {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  capacity     Int     @db.SmallInt
  isAvailable  Boolean @default(true)

  reservations Reservation[]
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation("RestaurantTables", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isAvailable])
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  tableId      String
  customerId   String
  timeSlotId   String
  guestCount   Int               @db.SmallInt
  status       ReservationStatus @default(PENDING)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation("RestaurantReservations", fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  timeSlot   TimeSlot   @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([tableId])
  @@index([timeSlotId])
}

model TimeSlot {
  id           String   @id @default(cuid())
  restaurantId String
  startTime    DateTime
  endTime      DateTime
  capacity     Int      @db.SmallInt
  isAvailable  Boolean  @default(true)

  reservations Reservation[]
  waitlists    Waitlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation("RestaurantTimeSlots", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, startTime, endTime])
}

model Waitlist {
  id           String @id @default(cuid())
  restaurantId String
  timeSlotId   String
  customerId   String
  guestCount   Int    @db.SmallInt
  rank         Int    @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation("RestaurantWaitlists", fields: [restaurantId], references: [id], onDelete: Cascade)
  timeSlot   TimeSlot   @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, timeSlotId, customerId])
  @@index([restaurantId, timeSlotId, rank])
}

model Menu {
  id           String  @id @default(cuid())
  name         String
  description  String?
  restaurantId String
  isActive     Boolean @default(true)

  menuItems MenuItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  restaurant Restaurant @relation("RestaurantMenus", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model MenuItem {
  id          String  @id @default(cuid())
  menuId      String
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model Review {
  id           String       @id @default(cuid())
  restaurantId String
  customerId   String
  rating       Int          @db.SmallInt
  comment      String?
  status       ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation("RestaurantReviews", fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([customerId])
}

model EmailsList {
  id           String  @id @default(cuid())
  restaurantId String
  email        String  @unique
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([email, isActive])
}

model PosSession {
  id             String              @id @default(cuid())
  restaurantId   String
  cashRegisterId String
  cashierId      String
  openingBalance Decimal             @db.Decimal(10, 2)
  closingBalance Decimal             @db.Decimal(10, 2)
  actualBalance  Decimal?            @db.Decimal(10, 2)
  discrepancy    Decimal?            @db.Decimal(10, 2)
  startTime      DateTime            @default(now())
  endTime        DateTime?
  notes          String?
  orders         Order[]
  entries        CashRegisterEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  cashRegister CashRegister    @relation(fields: [cashRegisterId], references: [id])
  cashier      RestaurantStaff @relation(fields: [cashierId], references: [id])

  @@index([restaurantId])
  @@index([cashRegisterId])
  @@index([cashierId])
}

model CashRegister {
  id             String              @id @default(cuid())
  restaurantId   String
  name           String
  status         CashRegisterStatus  @default(CLOSED)
  currentBalance Decimal             @db.Decimal(10, 2)
  lastOpenedAt   DateTime?
  lastClosedAt   DateTime?
  lastOpenedBy   String?
  lastClosedBy   String?
  notes          String?
  sessions       PosSession[]
  entries        CashRegisterEntry[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model CashRegisterEntry {
  id             String                @id @default(cuid())
  cashRegisterId String
  sessionId      String?
  type           CashRegisterEntryType
  amount         Decimal               @db.Decimal(10, 2)
  balance        Decimal               @db.Decimal(10, 2)
  notes          String?
  performedBy    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  cashRegister CashRegister    @relation(fields: [cashRegisterId], references: [id])
  session      PosSession?     @relation(fields: [sessionId], references: [id])
  staff        RestaurantStaff @relation(fields: [performedBy], references: [id])

  @@index([cashRegisterId])
  @@index([sessionId])
  @@index([performedBy])
}

enum Role {
  ADMIN
  USER
}

enum RestaurantRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  CHEF
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CreatedByType {
  CUSTOMER
  STAFF
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  DIGITAL_WALLET
  BANK_TRANSFER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  CASH
  CARD
  DIGITAL_WALLET
  GIFT_CARD
  SPLIT
}

enum OrderChannel {
  POS
  MOBILE
  WEB
}

enum CashRegisterStatus {
  OPEN
  CLOSED
  SUSPENDED
}

enum CashRegisterEntryType {
  OPENING_BALANCE
  CASH_IN
  CASH_OUT
  CLOSING_BALANCE
}
